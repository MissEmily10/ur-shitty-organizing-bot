{
  "description": "T + G + Enter вместе → окошко «Что записать?» → заметка в бот (быстрая команда «Заметка в бот»)",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "simultaneous": [
          {
            "key_code": "t"
          },
          {
            "key_code": "g"
          },
          {
            "key_code": "return_or_enter"
          }
        ],
        "simultaneous_options": {
          "key_down_order": "insensitive",
          "detect_key_down_uninterruptedly": true
        },
        "modifiers": {
          "optional": [
            "caps_lock"
          ]
        }
      },
      "parameters": {
        "basic.simultaneous_threshold_milliseconds": 80
      },
      "to": [
        {
          "shell_command": "shortcuts run 'Заметка в бот'"
        }
      ]
    }
  ]
}
